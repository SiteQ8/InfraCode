# InfraCode Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# API Server
# =============================================================================
INFRACODE_HOST=0.0.0.0
INFRACODE_PORT=8000
INFRACODE_DEBUG=false
INFRACODE_SECRET_KEY=change-this-to-a-random-secret-key-minimum-32-chars
INFRACODE_ALLOWED_ORIGINS=http://localhost:8080

# =============================================================================
# Encryption (AES-256-GCM for state files)
# =============================================================================
INFRACODE_ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# =============================================================================
# State Backend
# =============================================================================
INFRACODE_STATE_BACKEND=local
# Options: local, s3, azure_blob, gcs
INFRACODE_STATE_PATH=.infracode/state

# Remote state (S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# INFRACODE_S3_BUCKET=
# INFRACODE_S3_REGION=

# =============================================================================
# Cloud Providers
# =============================================================================
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# =============================================================================
# Vault (Secret Management)
# =============================================================================
INFRACODE_VAULT_BACKEND=local
# Options: local, hashicorp, aws_secrets_manager, azure_keyvault
HASHICORP_VAULT_ADDR=
HASHICORP_VAULT_TOKEN=

# =============================================================================
# Logging & Audit
# =============================================================================
INFRACODE_LOG_LEVEL=INFO
INFRACODE_AUDIT_LOG=.infracode/audit.log
INFRACODE_LOG_FORMAT=json

# =============================================================================
# Authentication
# =============================================================================
INFRACODE_AUTH_ENABLED=true
INFRACODE_JWT_EXPIRY=3600
INFRACODE_RBAC_ENABLED=true
